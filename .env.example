# Copy to .env for local non-docker runs (Node 24+ loads it with --env-file,
# e.g. `node --env-file=.env src/server.js`).

# Any Postgres-compliant database (RDS, Cloud SQL, Supabase, Neon, ...)
DATABASE_URL=postgres://dailycast:dailycast@localhost:5432/dailycast
# Set to "require" for managed providers that enforce TLS
#PGSSL=require

PORT=3000
#PG_POOL_MAX=10

# Product-day timezone (attempts/earnings expire on this boundary)
#DAY_TZ=Asia/Kolkata

# Internal Coin API (system-transactions, HTTP Basic auth) — server-side
# only, never exposed to the client. Leave COIN_API_URL unset to use the
# built-in at-most-once stub ledger (coin_credit_attempts table).
# Dev endpoint: https://dev-api.astrolokal.com/v1/system-transactions/
#COIN_API_URL=https://dev-api.astrolokal.com/v1/system-transactions/
#COIN_API_USER=replace-me
#COIN_API_PASS=replace-me

# Gemini — nightly generation of the daily reading pool (server-side only).
# Leave unset to use the sampleVariants from the experiment config; any
# Gemini failure also falls back to those, so the page never breaks.
#GEMINI_API_KEY=replace-me
#GEMINI_MODEL=gemini-2.5-flash

# Override the experiment config location (k8s mounts a ConfigMap here)
#EXPERIMENT_CONFIG_PATH=/etc/daily-cast/experiment.config.json
